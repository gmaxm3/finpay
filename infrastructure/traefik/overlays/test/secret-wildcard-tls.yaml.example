apiVersion: v1
kind: Secret
metadata:
  name: finpay-wildcard-tls
  namespace: kube-system
type: kubernetes.io/tls
stringData:
  tls.crt: |
    -----BEGIN CERTIFICATE-----
    <wildcard cert *.finpay.com.ua>
    -----END CERTIFICATE-----
    -----BEGIN CERTIFICATE-----
    <intermediate CA cert — GoDaddy G2>
    -----END CERTIFICATE-----
  tls.key: |
    -----BEGIN PRIVATE KEY-----
    <private key>
    -----END PRIVATE KEY-----
